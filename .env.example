# Linux-Voice-Assistant - Docker Environment Configuration
# Copy this file to .env and customize for your setup by 'cp .env.example .env'

### Specify another docker image (optional):
# LVA_IMAGE="ghcr.io/ohf-voice/linux-voice-assistant"
# LVA_IMAGE_TAG="latest"

### Enable debug mode (optional):
# ENABLE_DEBUG="1"

### Enable colored debug mode (optional):
# ENABLE_COLORED_DEBUG="1"

### List audio devices (optional):
# if enabled normal startup is disabled
# LIST_DEVICES="1"

### User ID:
# This is used to set the correct permissions for the accessing the audio device and accessing the PulseAudio socket
LVA_USER_ID="1000"
LVA_USER_GROUP="1000"

### Name for the client (optional):
# CLIENT_NAME="speaker_livingroom"

### PulseAudio socket path on the host:
# PulseAudio Server:    /run/user/1000/pulse
# Pipewire Server:      /run/user/1000/pulse/native
LVA_PULSE_SERVER="/run/user/${LVA_USER_ID}/pulse/native"
LVA_XDG_RUNTIME_DIR="/run/user/${LVA_USER_ID}"
LVA_PULSE_COOKIE="/run/user/${LVA_USER_ID}/pulse/cookie"

### Path to the preferences file (optional):
# PREFERENCES_FILE="/app/configuration/preferences.json"

### Network interface (optional):
# NETWORK_INTERFACE="eth0"

### MAC address the device is known by in Home Assistant (optional; default: the network
### interface's). One identity across interfaces, or several instances on one machine:
# MAC_ADDRESS="02:00:00:00:00:01"

### IP-Address for the api (optional):
# HOST="0.0.0.0"

### Port for the api (optional):
# PORT="6053"

### Encryption (optional):
### On first start LVA creates a key file next to the preferences file (/app/configuration/encryption.key).
### Home Assistant asks for that key when adding the device; you can read it with docker compose exec linux-voice-assistant cat /app/configuration/encryption.key
# ENABLE_ENCRYPTION="1"

### Use another key file (a path inside the container, created if it does not exist):
# ENCRYPTION_KEY_FILE="/app/configuration/encryption.key"

### Audio input device (optional):
# AUDIO_INPUT_DEVICE="default"

### Audio input block size in samples (optional):
# AUDIO_INPUT_BLOCK_SIZE="1024"

### Audio output device (optional):
### Defaults to "pulse", the default PulseAudio output. To select a specific device use a
### name starting with "pulse/" from the device list (LIST_DEVICES="1"), for example
### "pulse/alsa_output.usb-Example.analog-stereo".
# AUDIO_OUTPUT_DEVICE="pulse"

### What the music player does while the assistant talks or an announcement plays (optional):
### "duck" (default) lowers the volume, "pause" pauses the music and resumes it afterwards.
# MPV_PLAYER_DUCK_MODE="duck"

### Sendspin bridge (optional):
### LVA ducks a Sendspin player (sendspin-cli, e.g. the Local Audio add-on) while you talk and during announcements, and shows it in the media player.
### 1 is the default of the application and turns it on, 0 turns it off. Nothing happens while the socket does not exist.
# ENABLE_SENDSPIN_BRIDGE="1"
### Directory that holds the control socket (control.sock), mounted at the same path in the container. The socket belongs
### to the user of the player container (mode 0600), so LVA_USER_ID has to be the same user.
# SENDSPIN_CONTROL_DIR="/run/sendspin-cli"
### What a Sendspin player does while the assistant talks or an announcement plays: "stop" (default) stops it and starts it
### again afterwards, "duck" lowers the group volume. With "duck" the volume is synchronised through Sendspin and is not
### protected against changes while it is lowered, see the README.
# SENDSPIN_PLAYER_DUCK_MODE="stop"

### Microphone volume level (optional):
# MIC_VOLUME="100"

### Mic Gain (optional) passed as an argument to LVA will overide the value in the preferences file on boot but can be changed at runtime in Home Assistant:
# MIC_AUTO_GAIN="0"

### Mic Noise Suppression (optional) passed as an argument to LVA will overide the value in the preferences file on boot but can be changed at runtime in Home Assistant:
# MIC_NOISE_SUPPRESSION="0"

### Number of mic channels to capture (2 for devices with a hardware AEC reference channel)
# AUDIO_INPUT_CHANNELS=1

### Enable thinking sound (optional):
# ENABLE_THINKING_SOUND="1"

### Start listening during wake sound (optional):
# Start listening immediately after wake word detection, without waiting for the wake sound to finish
# LISTEN_DURING_WAKE_SOUND="1"

### Perpheral api host (optional):
# Bind address for the peripheral WebSocket API
# PERIPHERAL_HOST="0.0.0.0"

### Perpheral api port (optional):
# Port for the peripheral WebSocket API
# PERIPHERAL_PORT="6055"

### Peripheral api volume step (optional):
# Volume change for peripheral api per button press, 0.0–1.0
# PERIPHERAL_VOLUME_STEP="%(default)s"

### Peripheral api startup wait (optional):
# Seconds to wait for peripherals to register their entities before Home Assistant enumerates them (0 to skip)
# PERIPHERAL_STARTUP_WAIT="2.0"

### Disable the peripheral WebSocket API entirely
# DISABLE_PERIPHERAL_API="1"

### Wake word directory (optional):
# path for custom files in docker is for example "app/wakewords/custom"
# WAKE_WORD_DIR="app/wakewords"

### Wake model (optional):
# WAKE_MODEL="okay_nabu"

### Stop model (optional):
# STOP_MODEL="stop"

### Download directory for custom wake word models (optional):
# DOWNLOAD_DIR="/app/local"

### Seconds after which the timer stops ringing (optional):
# TIMER_MAX_RING_SECONDS="900"

### Refactory seconds (optional):
# REFACTORY_SECONDS="2"

### Delay before mic opens for continued conversation (optional):
# CONTINUE_CONVERSATION_DELAY="0.5"

### Sound files (optional):
# path for custom files in docker is for example "sounds/custom/your_soundfile.flac"
# WAKEUP_SOUND="sounds/wake_word_triggered.flac"
# TIMER_FINISHED_SOUND="sounds/timer_finished.flac"
# PROCESSING_SOUND="sounds/processing.wav"
# MUTE_SOUND="sounds/mute_switch_on.flac"
# UNMUTE_SOUND="sounds/mute_switch_off.flac"
# PIPELINE_ENDED_SOUND="sounds/pipeline_ended_low.flac"
# BUTTON_DOUBLE_PRESS_SOUND="sounds/button_double_press.flac"
# BUTTON_TRIPLE_PRESS_SOUND="sounds/button_triple_press.flac"
# BUTTON_LONG_PRESS_SOUND="sounds/button_long_press.flac"

### Enable output-only mode (optional):
# ENABLE_OUTPUT_ONLY="1"

