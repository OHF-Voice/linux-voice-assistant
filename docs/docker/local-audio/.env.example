# Music Assistant Local Audio - Docker Environment Configuration for docker-compose.yml
# https://github.com/music-assistant/local-audio-addon
# Standalone operation outside the Home Assistant OS apps. Copy this file to .env and set what you need.
# Every option is optional, the values below are the defaults. An option that is not set keeps the default of the image.
# The options of the player are the same as in docker-compose.build.yml, see the README for each of them.

### Docker image (optional):
# LOCAL_AUDIO_IMAGE="ghcr.io/music-assistant/local-audio-addon"
# LOCAL_AUDIO_IMAGE_TAG="latest"

### Control socket (optional):
# Directory on the host that holds the control socket of the player, as control.sock, and the rendered
# configuration. In the container the image always uses /run/sendspin-cli, so that path is not an option.
# LOCAL_AUDIO_CONTROL_DIR="/run/sendspin-cli"

### User:
# The player runs as this user, which has to be allowed to use the audio socket of the host. The control socket
# is created for this user with mode 0600, so programs that talk to it have to run as the same user.
LOCAL_AUDIO_USER_ID="1000"
LOCAL_AUDIO_USER_GROUP="1000"

### Name shown in Music Assistant:
# Left unset, the player is named after the host (its hostname). The image itself would call every player
# `Local Audio`, so name them when running more than one on a network.
# SENDSPIN_NAME="Living Room"

### Audio output:
# `default` follows /etc/asound.conf, `pulse` and `pipewire` reach a sound server on the host through the native
# backends, a bare name that is none of those is an ALSA PCM such as `hw:1,0`, and `null` discards the audio.
# `pulse:<sink>` and `pipewire:<node>` name a sink or a node. `docker compose exec local-audio sendspin-cli -l`
# lists what this container can actually see, sound-server sinks and nodes included.
#
# pulse             Native PulseAudio backend. Also works with pipewire-pulse (Pipewire).
# pulse:<sink>      A specific PulseAudio sink
# pipewire          Native Pipewire backend (needs the Pipewire socket in the runtime directory)
# pipewire:<node>   A specific Pipewire node
# default           ALSA, follows /etc/asound.conf
# hw:1,0            An ALSA device
# null              Discards the audio
# List what the container sees: docker compose exec local-audio sendspin-cli -l
# docker-compose.yml maps the ALSA devices (/dev/snd) and the sound server of the host into the container. Set `pulse`
# (or `pipewire`) to play through the sound server of the host.
SENDSPIN_OUTPUT="default"

### Native PulseAudio output (SENDSPIN_OUTPUT="pulse"):
# Derived from the user above, so that there is nothing to adjust for a regular user. The directory of the sound
# server on the host is mounted into the container at the same path. Reach for it when
# the host runs PulseAudio, or pipewire-pulse: `-l` can then name the server's sinks, the host's mixer sees a stream
# called sendspin-cli, and the sync figure is the server's rather than an ALSA plugin's own buffering. On Fedora or
# RHEL, SELinux can deny the mount: add `:z` to it in docker-compose.yml there.
LOCAL_AUDIO_XDG_RUNTIME_DIR="/run/user/${LOCAL_AUDIO_USER_ID}"
# The address of the sound server, LOCAL_AUDIO_PULSE_SERVER, so that nothing has to be adjusted for a regular user.
LOCAL_AUDIO_PULSE_SERVER="unix:${LOCAL_AUDIO_XDG_RUNTIME_DIR}/pulse/native"
# The cookie authenticates the client, and is unnecessary only where the socket is configured `auth-anonymous=1`.
# The container has to be able to read it, which docker-compose.yml hands to it as PULSE_COOKIE.
LOCAL_AUDIO_PULSE_COOKIE="${LOCAL_AUDIO_XDG_RUNTIME_DIR}/pulse/cookie"

### Native PipeWire output (SENDSPIN_OUTPUT="pipewire"):
# The same shape, for a host running PipeWire. It reaches the same server `pulse` does through pipewire-pulse; what it
# adds is that only a native client can name a *node*, and that nothing translates the audio path. It is the only
# route where pipewire-pulse is not installed. The whole runtime directory is mounted and LOCAL_AUDIO_XDG_RUNTIME_DIR
# points to it, so the socket is found there. PIPEWIRE_REMOTE takes an absolute path, for another socket.
# PIPEWIRE_REMOTE="/run/user/1000/pipewire-0"

### Log level:
# none, error, warn, info, debug, verbose
# SENDSPIN_LOG_LEVEL="info"

### Audio buffer:
# How much audio the output keeps buffered, 10 to 2000 milliseconds. Left unset the player picks its own figure;
# raise it where the sound breaks up on a busy or slow machine, at the cost of a longer wait when a track starts
# or is seeked. Anything that is not a whole number in that range stops the container with a line naming it.
# SENDSPIN_BUFFER_MS="250"

### Port:
# The port the player listens on and the server connects back to, 1024 to 65535. Left unset the player uses 8928.
# A second player on the same host needs its own port, and its own pairing port if local pairing is on.
# SENDSPIN_PORT="8928"

### Preferred audio format:
# Move one format to the front of the list this player advertises, as <codec>:<rate>:<depth>:<channels>, for the
# DAC that is only happy in one shape. A format the output cannot advertise stops the player from starting rather
# than quietly playing something else, so set it only against a device whose capabilities `sendspin-cli -l` has
# confirmed.
# SENDSPIN_AUDIO_FORMAT="flac:48000:24:2"

### Pairing:
# A server has to pair with this player before it can play; the README's Pairing section covers how. The pairing
# token or code is written to the log: docker compose logs local-audio
# `true` lets any server on the network play without pairing, and anything but true or false stops the container.
# Set to true for now, so that Music Assistant can play without pairing. Anyone on the network can play then.
SENDSPIN_ALLOW_UNPAIRED="true"
# Serve the pairing token over HTTP on one address, so a Music Assistant that can reach it pairs by itself. Anything
# that can reach the address can pair, so name one only Music Assistant's host can reach; `true` with no address
# stops the container. The README's Pairing section.
# SENDSPIN_LOCAL_PAIRING="false"
# SENDSPIN_LOCAL_PAIRING_ADDRESS="192.0.2.1"
# SENDSPIN_LOCAL_PAIRING_PORT="8929"

### Audio input:
# Stream a capture device to the server, see "Streaming an input" in the README.
# SENDSPIN_INPUT=""

### ALSA options:
# Seconds, 0 to 3600, to keep an ALSA output playing silence after a stream.
# SENDSPIN_KEEP_OUTPUT_ALIVE=""
# `true` closes an ALSA device between streams.
# SENDSPIN_RELEASE_DEVICE="false"
# An ALSA hardware mixer, <card>:<control>, to drive for volume, and how volume maps onto it: `spec` or `cubic`.
# SENDSPIN_ALSA_MIXER=""
# SENDSPIN_ALSA_MIXER_CURVE="spec"

### Hooks:
# Run a shell command when a stream starts and when it stops, for example to switch an amplifier relay on and off
# again. The value is a command, not data: it is handed to `sh -c` inside the container and runs with whatever that
# container can reach. The event's facts arrive as SENDSPIN_EVENT (start|stop) and, where the server said so,
# SENDSPIN_SERVER_ID, SENDSPIN_SERVER_NAME, SENDSPIN_SERVER_URL, SENDSPIN_CLIENT_ID and SENDSPIN_CLIENT_NAME.
# Neither holds up playback, and a non-zero exit is a warning in the log rather than a player failure.
# SENDSPIN_HOOK_START="curl -fsS -X POST http://192.168.1.20/relay/0?turn=on"
# SENDSPIN_HOOK_STOP="curl -fsS -X POST http://192.168.1.20/relay/0?turn=off"

### Connection to the server:
# Dial out to one specific server instead of waiting to be discovered. Any value here suppresses the mDNS
# advertisement. Unset, the player announces itself over mDNS through the Avahi of the host, which has to run.
# <host>[:<port>], a ws:// URL, or mdns:<name> to resolve a server by its name
# SENDSPIN_SERVER="192.168.1.10:8927"
