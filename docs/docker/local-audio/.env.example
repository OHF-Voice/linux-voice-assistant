# Music Assistant Local Audio - Docker Environment Configuration
# https://github.com/music-assistant/local-audio-addon
# Every option is optional, the values below are the defaults.

### Docker image (optional):
# LOCAL_AUDIO_IMAGE="ghcr.io/music-assistant/local-audio-addon"
# LOCAL_AUDIO_IMAGE_TAG="latest"

### Container name (optional):
# Also names the directory of the control socket on the host: /run/<container name>/control.sock
# Use a different name (and a different compose project and port) for every instance on a system.
# LOCAL_AUDIO_CONTAINER_NAME="local-audio"

### Port (optional):
# Port of the player, the server connects to it. Every instance on a system needs its own.
# LOCAL_AUDIO_PORT="8928"

### User ID:
# This is used to set the correct permissions for the accessing the audio device and accessing the PulseAudio socket
LOCAL_AUDIO_USER_ID="1000"
LOCAL_AUDIO_USER_GROUP="1000"

### PulseAudio socket path on the host:
# PulseAudio Server:    /run/user/1000/pulse
# Pipewire Server:      /run/user/1000/pulse/native
LOCAL_AUDIO_PULSE_SERVER="unix:/run/user/${LOCAL_AUDIO_USER_ID}/pulse/native"
LOCAL_AUDIO_XDG_RUNTIME_DIR="/run/user/${LOCAL_AUDIO_USER_ID}"

### Name shown in Music Assistant (optional):
# Unset, the player uses the name of the host. Name every player when you run more than one on a network.
# LOCAL_AUDIO_NAME="Living Room"

### Audio output (optional):
# pulse             Native PulseAudio backend. Also works with pipewire-pulse (Pipewire).
# pulse:<sink>      A specific PulseAudio sink
# pipewire          Native Pipewire backend (needs the Pipewire socket in the runtime directory)
# pipewire:<node>   A specific Pipewire node
# default           ALSA, follows /etc/asound.conf
# hw:1,0            An ALSA device
# null              Discards the audio
# List what the container sees: docker compose exec local-audio sendspin-cli -l
LOCAL_AUDIO_OUTPUT="pulse"

### Log level (optional):
# none, error, warn, info, debug, verbose
LOCAL_AUDIO_LOG_LEVEL="info"

### Audio buffer (optional):
# 10 to 2000 milliseconds. Unset, the player picks its own value. Raise it if the sound breaks up.
# LOCAL_AUDIO_BUFFER_MS="250"

### Preferred audio format (optional):
# <codec>:<rate>:<depth>:<channels>[,...], for example flac:48000:24:2
# A format that the output cannot advertise stops the player from starting.
# LOCAL_AUDIO_AUDIO_FORMAT="flac:48000:24:2"

### Connection to the server (optional):
# Unset, the player announces itself over mDNS (through the Avahi of the host) and waits for Music Assistant.
# A value dials out to the server instead and turns the announcement off.
# <host>[:<port>], a ws:// URL, or mdns:<name> to discover a server by its name
# LOCAL_AUDIO_SERVER="192.168.1.10:8927"

### Player ID (optional):
# Stable client id under which the server files volume and groups. Unset, it is derived from the MAC address of
# the network interface. Only for images with sendspin-cli up to 0.3.x. Newer images (0.4 and later) refuse the key
# and do not start while it is set, they identify the player by a key in the data volume instead.
# LOCAL_AUDIO_ID="living-room"

### Pairing (optional):
# Newer images (sendspin-cli 0.4 and later) require the server to pair with the player before it can play. The
# pairing token or code is written to the log: docker compose logs local-audio
# Default "true": every server in the network may play without pairing. Set "false" to require pairing. Older
# images (sendspin-cli up to 0.3.x) may not know the option, set "false" for them.
# LOCAL_AUDIO_ALLOW_UNPAIRED="true"

### Hooks (optional):
# Shell commands that run when a stream starts and stops, for example to switch an amplifier.
# LOCAL_AUDIO_HOOK_START="curl -fsS -X POST http://192.168.1.20/relay/0?turn=on"
# LOCAL_AUDIO_HOOK_STOP="curl -fsS -X POST http://192.168.1.20/relay/0?turn=off"
